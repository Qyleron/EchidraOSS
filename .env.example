# Echidra local configuration template.
# Copy this file to .env and edit values for your machine.
# The real .env file is ignored by git so secrets stay local.

# Honeypot listener
ECHIDRA_HOST=0.0.0.0
ECHIDRA_PORT=2222
ECHIDRA_MAX_CONNECTIONS=100
ECHIDRA_READ_TIMEOUT=60

# Honeypot persona selection and JSONL session log.
# Persona definitions live in honeypot/core/persona.py; this selects one preset.
ECHIDRA_PERSONA=generic_linux
ECHIDRA_SESSION_LOG=logs/sessions.jsonl

# PostgreSQL storage for /classify/session/store
# Keep real credentials only in your local .env file.
# If your password contains URL special characters, percent-encode it first.
# Example password "p@ss/word" becomes "p%40ss%2Fword".
# ECHIDRA_DATABASE_URL=postgresql://echidra:echidra@localhost:5432/echidra
ECHIDRA_DATABASE_URL=

# Required to use POST /classify/session/store. This endpoint writes to the
# database and can trigger alert emails, so it refuses all requests until you
# set a shared secret here and send it back as the X-Api-Key header. Generate
# one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ECHIDRA_INGEST_API_KEY=

# By default, POST /auth/signup only works until the first dashboard account
# exists (a self-hosted single-operator deployment shouldn't stay open to
# public registration forever). Set this to true if you want more than one
# dashboard user and are managing access yourself.
ECHIDRA_ALLOW_SIGNUPS=false

# Optional dashboard session signing secret.
# If unset, a fallback secret is auto-generated and persisted to
# logs/.dashboard_session_secret so logins still survive process restarts on
# this host. Set this explicitly when running multiple workers/hosts so they
# all sign and verify sessions with the same secret.
ECHIDRA_SESSION_SECRET=

# Set to true when the dashboard is served over HTTPS.
ECHIDRA_COOKIE_SECURE=false
