[Unit]
Description=Echidra OSS honeypot listeners
After=network.target

[Service]
Type=simple
User=echidra
Group=echidra
WorkingDirectory=/opt/echidra
EnvironmentFile=/opt/echidra/.env
ExecStart=/opt/echidra/venv/bin/python -m honeypot.main
Restart=on-failure
RestartSec=5

# Provisions data/ (see ReadWritePaths below) on every start, not just at
# initial install -- the "+" prefix runs this one line as root, ignoring
# User=/Group= and the ProtectSystem=strict sandbox below, so it can
# create/fix the directory even though the main process (and its
# unprivileged User=echidra) can't write to the root-owned /opt/echidra
# parent. Covers upgrades or re-provisioning flows that skip DEPLOYMENT.md's
# manual mkdir step, instead of relying on it having been run once by hand.
ExecStartPre=+/bin/sh -c 'mkdir -p /opt/echidra/data && chown echidra:echidra /opt/echidra/data && chmod 0700 /opt/echidra/data'

# Only needed if ECHIDRA_PORT/ECHIDRA_HTTP_PORT/etc. are set to privileged
# ports (80/21/23/22) instead of the non-privileged defaults
# (8080/2121/2323/2222). Uncomment if you need a privileged port -- left
# off by default since it grants a capability the process doesn't
# otherwise need.
#AmbientCapabilities=CAP_NET_BIND_SERVICE

# Hardening: this process only needs to read its own code/config, append
# to its own log file, and persist its SSH host key -- never write
# elsewhere. data/ holds the SSH host key (SSH_HOST_KEY_PATH defaults to
# data/ssh_host_key, relative to WorkingDirectory) -- without it in
# ReadWritePaths, ensure_host_key()'s first-run mkdir/write fails under
# ProtectSystem=strict and the SSH listener never comes up.
NoNewPrivileges=true
ProtectSystem=strict
# ProtectSystem=strict leaves /tmp and /var/tmp read-only, and some
# dependencies (e.g. the SSH library) call Python's tempfile module, which
# fails outright with no writable temp dir otherwise. PrivateTmp=true gives
# this unit its own private, writable /tmp instead of loosening
# ReadWritePaths onto the host's real /tmp.
PrivateTmp=true
ReadWritePaths=/opt/echidra/logs /opt/echidra/data

[Install]
WantedBy=multi-user.target
