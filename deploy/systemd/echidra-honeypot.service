[Unit]
Description=Echidra OSS honeypot listeners
After=network.target

[Service]
Type=simple
User=echidra
Group=echidra
WorkingDirectory=/opt/echidra
EnvironmentFile=/opt/echidra/.env
ExecStart=/opt/echidra/venv/bin/python -m honeypot.main
Restart=on-failure
RestartSec=5

# Only needed if ECHIDRA_PORT/ECHIDRA_HTTP_PORT/etc. are set to privileged
# ports (80/21/23/22) instead of the non-privileged defaults
# (8080/2121/2323/2222). Uncomment if you need a privileged port -- left
# off by default since it grants a capability the process doesn't
# otherwise need.
#AmbientCapabilities=CAP_NET_BIND_SERVICE

# Hardening: this process only needs to read its own code/config, append
# to its own log file, and persist its SSH host key -- never write
# elsewhere. data/ holds the SSH host key (SSH_HOST_KEY_PATH defaults to
# data/ssh_host_key, relative to WorkingDirectory) -- without it in
# ReadWritePaths, ensure_host_key()'s first-run mkdir/write fails under
# ProtectSystem=strict and the SSH listener never comes up.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/echidra/logs /opt/echidra/data

[Install]
WantedBy=multi-user.target
