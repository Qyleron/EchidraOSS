[Unit]
Description=Echidra OSS API and dashboard
After=network.target postgresql.service

[Service]
Type=simple
User=echidra
Group=echidra
WorkingDirectory=/opt/echidra
EnvironmentFile=/opt/echidra/.env
ExecStart=/opt/echidra/venv/bin/uvicorn classifier.api.app:create_app --factory --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/echidra/logs

[Install]
WantedBy=multi-user.target
